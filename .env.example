# MiniLoop environment configuration example.
# Do NOT commit real API keys to version control.
# Prefer loading credentials via MINILOOP_MODEL_API_KEY_FILE (default: ~/.config/miniloop/magpie.key).

# Provider mode: "fake" (offline deterministic double) or "openai_compatible" (real model gateway)
MINILOOP_MODEL_PROVIDER=fake

# OpenAI-compatible gateway base URL (defaults to local Magpie gateway on 127.0.0.1)
MINILOOP_MODEL_BASE_URL=http://127.0.0.1:3425/v1

# Required when MINILOOP_MODEL_PROVIDER=openai_compatible (e.g., claude-sonnet-5-5)
MINILOOP_MODEL_NAME=

# Secret credentials (leave empty in committed files)
MINILOOP_MODEL_API_KEY=
MINILOOP_MODEL_API_KEY_FILE=

# Default workspace directory
MINILOOP_WORKSPACE=./workspaces/demo_readonly

# Execution budgets
MINILOOP_MAX_MODEL_CALLS=10
MINILOOP_MAX_TOOL_CALLS=15
MINILOOP_MAX_WALL_TIME_SEC=120.0
